{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.babashka/cli {:mvn/version "0.8.67"}
        babashka/fs {:mvn/version "0.5.33"}
        babashka/process {:mvn/version "0.6.25"}}
 :aliases
 {:run-m {:main-opts ["-m" "suse.obs.vendor-helm"]}
  :run-x {:ns-default suse.obs.vendor-helm
          :exec-fn greet
          :exec-args {:name "Clojure"}}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.12"}
                 ;; Explicit Clojure version -- fully specifying the
                 ;; required libraries which removes reliance on root
                 ;; deps.end. Especially helpful for vendoring
                 ;; dependencies in environments not having internet
                 ;; connection.
                 org.clojure/clojure {:mvn/version "1.12.4"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
